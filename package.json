{
  "name": "kfp-dag-preview",
  "displayName": "KFP DAG Preview",
  "icon": "images/icon.png",
  "description": "Read-only local DAG preview for Kubeflow Pipelines",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Tolga Tuncoglu",
  "publisher": "TolgaTuncoglu",
  "repository": {
    "type": "git",
    "url": "https://github.com/tolgatuncoglu/kfp_local_visualization.git"
  },
  "homepage": "https://github.com/tolgatuncoglu/kfp_local_visualization#readme",
  "bugs": {
    "url": "https://github.com/tolgatuncoglu/kfp_local_visualization/issues"
  },
  "categories": [
    "Visualization",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "kubeflow",
    "kubeflow pipelines",
    "kfp",
    "dag",
    "mermaid",
    "mlops",
    "pipeline"
  ],
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Previewing compiled YAML works in Restricted Mode. Previewing a Python pipeline imports and executes local Python code, so it requires a trusted workspace.",
      "restrictedConfigurations": [
        "kfpDagPreview.kfpExecutable"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "kfpDagPreview.previewPython",
        "title": "KFP: Preview DAG"
      },
      {
        "command": "kfpDagPreview.previewYaml",
        "title": "KFP: Preview Compiled DAG"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kfpDagPreview.previewPython",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "KFP DAG Preview",
      "properties": {
        "kfpDagPreview.kfpExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the KFP CLI when the VS Code Python extension has no selected environment."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:integration": "npm run build && node test/integration/runner.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --out kfp-dag-preview.vsix"
  },
  "dependencies": {
    "mermaid": "^12.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
